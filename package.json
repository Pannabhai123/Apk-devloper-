{
  "name": "vidyapariksha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VidyaPariksha — full-stack online mock test & CBT examination platform",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "tsc -p server/tsconfig.build.json && node --input-type=module -e \"import fs from 'node:fs'; fs.copyFileSync('server/src/schema.sql','dist-server/schema.sql')\"",
    "start": "NODE_ENV=production node dist-server/index.js",
    "migrate": "tsx server/src/migrate.ts",
    "seed": "tsx server/src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "e2e": "tsx server/tests/e2e.workflow.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.15.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
