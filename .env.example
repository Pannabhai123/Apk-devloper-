# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public origin of THIS deployment. The SPA and API are served from one origin,
# so no CORS allowlist is needed. Used in the production CSP and as SITE_URL
# fallback for robots.txt / sitemap.xml.
PUBLIC_ORIGIN=http://localhost:5173
# On a provider-assigned subdomain (e.g. https://your-app.onrender.com) you can
# leave PUBLIC_ORIGIN blank: the server derives the public HTTPS origin from each
# request, including for password-reset links. Set it only when the site is
# served from a host you control and differs from the request host.
# Optional explicit canonical URL if it differs from PUBLIC_ORIGIN.
SITE_URL=
# Set to 1 when running behind a TLS-terminating reverse proxy.
TRUST_PROXY=0

# ── Database ───────────────────────────────────────────────────────────────
# File-based SQLite-compatible database (better-sqlite3 engine).
DATABASE_PATH=./data/vidyapariksha.db
# Directory for uploaded question images (served at /uploads).
UPLOAD_DIR=./data/uploads
# Only needed when the compiled server lives somewhere other than ./dist-server.
# WEB_DIST=./dist

# ── One-time first-administrator bootstrap ──────────────────────────────────
# Set this to a random value (16+ chars) when you are about to launch a fresh
# database. It unlocks the single "Set up the first administrator" form on the
# login page. The moment an administrator exists the flow closes permanently and
# this secret becomes useless. Leave it blank to keep the flow disabled.
ADMIN_BOOTSTRAP_SECRET=

# ── First-run content ───────────────────────────────────────────────────────
# true  -> on a database with zero questions, load the 433-question demo bank
#          once. The seed is idempotent and skips anything already present, so it
#          can never duplicate or overwrite your own content.
# false -> start with an empty bank and import your own questions.
SEED_DEMO_ON_EMPTY=true

# ── Security ───────────────────────────────────────────────────────────────
# REQUIRED in production, 32+ chars. Generate with: openssl rand -hex 32
# The server REFUSES to boot in production with a blank, short or obvious value.
# Rotating this value invalidates every existing session (by design).
SESSION_SECRET=
SESSION_TTL_HOURS=168
GUEST_TTL_HOURS=720
# true when served over HTTPS in production (required unless the escape hatch below is set).
COOKIE_SECURE=false
# Local HTTP smoke tests only. NEVER set this in a real deployment.
ALLOW_INSECURE_COOKIES=0
# Passwords are hashed with scrypt (N=2^15, maxmem 96 MB).
ALLOW_REGISTRATION=true
GUEST_TESTS_ENABLED=true
MAINTENANCE_MODE=false

# ── Password recovery / email delivery boundary ────────────────────────────
# No provider is bundled. With MAIL_PROVIDER=none, POST /api/auth/password/forgot
# returns an honest 503 instead of claiming a link was sent.
#   none    -> delivery unavailable
#   console -> DEVELOPMENT ONLY: writes the link to the server log
#   smtp    -> SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_SECURE, MAIL_FROM
#   resend  -> RESEND_API_KEY, MAIL_FROM
MAIL_PROVIDER=none
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=
RESET_TOKEN_TTL_SECONDS=3600
# DEVELOPMENT/TEST ONLY. Returns the raw reset token in the API response.
# assertProductionSecrets() refuses to boot when this is true in production.
EXPOSE_DEV_RESET_TOKEN=false

# ── First administrator ────────────────────────────────────────────────────
# Two supported routes, both secure and neither hardcoded in the source:
#
# A. One-time web form (best for a hosted deploy): set ADMIN_BOOTSTRAP_SECRET,
#    then open /setup-admin on the live site and choose the admin email and
#    password. The form exists only while the database has no administrator.
#
# B. CLI (best for a server you control):
#   npx tsx server/src/index.ts --setup-admin you@example.com 'a-strong-password'
#   npx tsx server/src/index.ts --rotate-admin you@example.com 'a-new-strong-password'
# NEVER commit a real password here. Rotate any credential ever shared in chat/logs.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Live workflow check (npm run e2e) ──────────────────────────────────────
# E2E_BASE_URL=http://127.0.0.1:5173
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=<set-in-your-shell-not-in-a-file>
