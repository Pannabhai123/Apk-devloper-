# SERVER ONLY — never copy these values into frontend/.env or the Android app.
# Local deterministic PDF extraction, editing, PPTX/PDF exports work without AI.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Set true only when you want AI to attempt extraction before the local parser.
AI_EXTRACTION_ENABLED=false

MAX_UPLOAD_MB=50
# DATA_DIR=/absolute/path/to/persistent/storage
# FRONTEND_DIST=/absolute/path/to/dist
# Comma-separated additional web origins, if the frontend is hosted separately:
# CORS_ORIGINS=https://classes.example.com
